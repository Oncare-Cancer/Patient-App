{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "local-build": "sudo rm -rf android ios && sudo rm -rf .expo && sudo rm -rf ~/.gradle/caches/ && sudo rm -rf android/.gradle/  && sudo rm -rf .expo .expo-shared && sudo rm -rf ~/.gradle/caches/ && sudo rm -rf ~/.gradle/daemon/ && sudo rm -rf node_modules/.cache && sudo rm -rf ~/.eas/build-cache/ && sudo npm cache clean --force && sudo rm -rf /tmp/metro-* && echo 'going to prebuild' && npx expo prebuild --clean && node scripts/locally-fix-gradle.js && cd android && echo 'gradelw clean now' && ./gradlew clean --no-daemon --info && cd ../ && echo 'going to build' && NODE_OPTIONS=--max_old_space_size=8192 eas build --platform android --local"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-firebase/app": "^23.4.1",
    "@react-native-firebase/messaging": "^23.4.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "axios": "^1.12.2",
    "expo": "^58.0.23",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "~19.3.0",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  }
}
