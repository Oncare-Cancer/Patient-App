{
  "expo": {
    "name": "Oncare Plus",
    "slug": "oncarecancer",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/new_images/icon-1024-1024.png",
    "splash": {
      "image": "./assets/new_images/splash-4096-4096.png",
      "contentFit": "contain",
      "backgroundColor": "#262f82"
    },
    "androidStatusBar": {
      "backgroundColor": "#262f82",
      "barStyle": "light-content"
    },
    "notification": {
      "icon": "./assets/new_images/icon-1024-1024.png",
      "color": "#262f82"
    },
    "android": {
      "package": "com.oncare.patientmanagementapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/new_images/adaptive-icon.png",
        "backgroundColor": "#262f82"
      },
      "splash": {
        "image": "./assets/new_images/splash-4096-4096.png",
        "resizeMode": "contain",
        "backgroundColor": "#262f82"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "DOWNLOAD_WITHOUT_NOTIFICATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleServices": {
          "disableVersionCheck": false
        }
      },
      "manifest": {
        "metaData": {
          "com.google.firebase.messaging.default_notification_color": {
            "resource": "@color/notification_icon_color"
          }
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oncare.patientmanagementapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "splash": {
        "image": "./assets/new_images/splash-4096-4096.png",
        "resizeMode": "contain",
        "backgroundColor": "#262f82"
      },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Montserrat-Regular.ttf",
            "./assets/fonts/Montserrat-Medium.ttf",
            "./assets/fonts/Montserrat-SemiBold.ttf",
            "./assets/fonts/NotoSansDevanagari-Regular.ttf",
            "./assets/fonts/NotoSansDevanagari-Medium.ttf",
            "./assets/fonts/NotoSansDevanagari-SemiBold.ttf"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Oncare uses your approximate location to show the Oncare centre nearest to you and its doctors. Your location is used only while the app is open.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosReducedAccuracyByDefault": true,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-web-browser",
      "./plugins/withAndroidManifestFix",
      "./plugins/withFirebaseModularHeaders"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcf640f1-4ef7-4fdf-abe0-cdd3e913ccb9"
      }
    },
    "owner": "oncarecancer-app",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fcf640f1-4ef7-4fdf-abe0-cdd3e913ccb9"
    }
  }
}
